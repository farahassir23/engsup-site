---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const current = Astro.url.pathname;
---

<header class="border-b border-ink/10">
  <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-6 py-5">
    <a href="/" class="shrink-0">
      <img src="/images/logo/logo.png" alt="Engineering Supplies Inc" class="h-8 w-auto" />
    </a>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {links.map((link) => {
        const isActive = current === link.href || (link.href !== '/' && current.startsWith(link.href));
        return (
          <li>
            <a
              href={link.href}
              class:list={[
                'whitespace-nowrap transition-colors hover:text-accent',
                isActive ? 'text-accent' : 'text-ink/70',
              ]}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
