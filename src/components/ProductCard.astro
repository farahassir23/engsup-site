---
interface Props {
  title: string;
  summary: string;
  image?: string;
  imageAlt?: string;
  category?: string;
}

const { title, summary, image, imageAlt = title, category } = Astro.props;
---

<article class="group">
  <div class="aspect-square w-full overflow-hidden bg-ink/5">
    {image ? (
      <img
        src={image}
        alt={imageAlt}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-xs uppercase tracking-widest text-ink/30">
        Photo coming soon
      </div>
    )}
  </div>
  <div class="mt-4">
    {category && <p class="text-xs uppercase tracking-widest text-accent">{category}</p>}
    <h3 class="mt-1 text-lg font-medium">{title}</h3>
    <p class="mt-1 text-sm text-ink/60">{summary}</p>
  </div>
</article>
