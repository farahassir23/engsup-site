---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products'))
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 3);
---

<Layout title="Home" description="A minimalist brochure site.">
  <section class="mx-auto max-w-5xl px-6 py-24 text-center">
    <h1 class="text-4xl font-medium tracking-tight sm:text-5xl">Engineering Supplies Inc</h1>
    <p class="mx-auto mt-4 max-w-xl text-ink/60">
      A short line about what this brand makes and why it's worth a look. Replace this with real copy once it's ready.
    </p>
    <a
      href="/products"
      class="mt-8 inline-block border border-ink px-6 py-3 text-sm uppercase tracking-widest transition-colors hover:border-accent hover:text-accent"
    >
      View the Showcase
    </a>
  </section>

  {products.length > 0 && (
    <section class="mx-auto max-w-5xl px-6 pb-24">
      <h2 class="text-sm uppercase tracking-widest text-ink/40">Featured</h2>
      <div class="mt-6 grid grid-cols-1 gap-10 sm:grid-cols-3">
        {products.map((product) => (
          <ProductCard
            title={product.data.title}
            summary={product.data.summary}
            image={product.data.image}
            imageAlt={product.data.imageAlt}
            category={product.data.category}
          />
        ))}
      </div>
    </section>
  )}
</Layout>
