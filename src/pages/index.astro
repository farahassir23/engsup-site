---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from 'astro:content';

const allProducts = (await getCollection('products')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);

const sectionOrder = ['Hazardous & Industrial', 'Meeting & Conferencing', 'Education & Art', 'Other'] as const;
const sections = sectionOrder
  .map((name) => ({ name, products: allProducts.filter((p) => p.data.section === name) }))
  .filter((s) => s.products.length > 0);
---

<Layout title="Home" description="Hazardous-environment equipment, meeting and conferencing technology, and STEAM educational products.">
  <section class="mx-auto max-w-5xl px-6 py-24 text-center">
    <h1 class="text-3xl font-medium tracking-tight sm:text-4xl">
      Equipping classrooms, boardrooms, and job sites with the technology that works.
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-ink/60">
      From rugged, hazardous-environment gear for oil and gas to meeting and conferencing technology and hands-on
      STEAM kits for the classroom — we help you find the right tool for the job.
    </p>
    <a
      href="#catalog"
      class="mt-8 inline-block border border-ink px-6 py-3 text-sm uppercase tracking-widest transition-colors hover:border-accent hover:text-accent"
    >
      Browse the Catalog
    </a>
  </section>

  <section id="catalog" class="mx-auto max-w-5xl px-6 pb-24">
    {sections.map((section, i) => (
      <div class:list={[i > 0 && 'mt-20 border-t border-ink/10 pt-16']}>
        <h2 class:list={[
          'tracking-tight',
          section.name === 'Other' ? 'text-sm uppercase tracking-widest text-ink/40' : 'text-2xl font-medium',
        ]}>
          {section.name}
        </h2>
        <div class="mt-8 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {section.products.map((product) => (
            <ProductCard
              title={product.data.title}
              summary={product.data.summary}
              image={product.data.image}
              imageAlt={product.data.imageAlt}
              imageFit={product.data.imageFit}
              category={product.data.category}
              partNumber={product.data.partNumber}
            />
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>
