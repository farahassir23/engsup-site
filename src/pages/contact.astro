---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Site Name.">
  <section class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="text-3xl font-medium tracking-tight">Contact</h1>
    <p class="mt-2 text-ink/60">Have a question? Reach out directly.</p>

    <dl class="mt-10 space-y-6 text-ink/70">
      <div>
        <dt class="text-xs uppercase tracking-widest text-ink/40">Email</dt>
        <dd class="mt-1">
          <a href="mailto:hello@example.com" class="hover:text-accent">hello@example.com</a>
        </dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-widest text-ink/40">Location</dt>
        <dd class="mt-1">City, State</dd>
      </div>
    </dl>
  </section>
</Layout>
