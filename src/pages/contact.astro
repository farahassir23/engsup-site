---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Engineering Supplies Inc.">
  <section class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="text-3xl font-medium tracking-tight">Contact</h1>
    <p class="mt-2 text-ink/60">Have a question? Reach out directly.</p>

    <dl class="mt-10 space-y-6 text-ink/70">
      <div>
        <dt class="text-xs uppercase tracking-widest text-ink/40">Email</dt>
        <dd class="mt-1">
          <a href="mailto:info@engsup.com" class="hover:text-accent">info@engsup.com</a>
        </dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-widest text-ink/40">Phone</dt>
        <dd class="mt-1">
          <a href="tel:+17034786009" class="hover:text-accent">703.478.6009</a>
        </dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-widest text-ink/40">Address</dt>
        <dd class="mt-1">45190 Prologis Plaza, Suite 165<br />Dulles, VA 20166, USA</dd>
      </div>
    </dl>
  </section>
</Layout>
