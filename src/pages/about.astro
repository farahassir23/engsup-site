---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="About Engineering Supplies Inc.">
  <section class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="text-3xl font-medium tracking-tight">About</h1>
    <div class="mt-6 space-y-4 text-ink/70">
      <p>
        We're passionate about equipping people with the right technology for where they work — whether that's a
        classroom, a boardroom, or a hazardous job site in the field. Our solutions help transform everyday spaces
        and demanding environments alike into ones where people can learn, meet, and work more seamlessly.
      </p>
      <p>
        Engineering Supplies, Inc. is headquartered in Virginia, USA. Since we were founded in 1989, we've focused
        on providing innovative solutions for education, business, and industrial environments.
      </p>
    </div>
  </section>
</Layout>
